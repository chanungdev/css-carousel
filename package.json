{
  "name": "snapstrip",
  "version": "0.0.0",
  "description": "CSS-first carousel built on scroll-snap, ::scroll-button() and ::scroll-marker()",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanungdev/snapstrip.git"
  },
  "homepage": "https://github.com/chanungdev/snapstrip#readme",
  "bugs": "https://github.com/chanungdev/snapstrip/issues",
  "keywords": [
    "carousel",
    "slider",
    "scroll-snap",
    "scroll-marker",
    "scroll-button",
    "css",
    "accessibility",
    "react",
    "vue",
    "angular"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/carousel.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/carousel.js"
    },
    "./carousel.css": "./dist/carousel.css",
    "./effects.css": "./dist/effects.css",
    "./themes/basic.css": "./dist/themes/basic.css",
    "./themes/progress.css": "./dist/themes/progress.css"
  },
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "node scripts/build.js && tsc --project test/types/tsconfig.json",
    "build": "node scripts/build.js",
    "size": "node scripts/size-check.js",
    "prepublishOnly": "node scripts/check-readme.js && pnpm lint && pnpm format:check && node scripts/build.js && node scripts/size-check.js && tsc --project test/types/tsconfig.json && playwright test",
    "check:readme": "node scripts/check-readme.js",
    "check:demo": "node scripts/check-site.js",
    "docs:dev": "pnpm --filter @snapstrip/site dev",
    "docs:build": "node scripts/check-site.js && pnpm --filter @snapstrip/site build",
    "lint": "eslint . && stylelint \"src/**/*.css\" \"site/src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" \"site/src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "//": "esbuild는 플랫폼 바이너리를 optionalDependencies로 배포하므로 postinstall 없이 동작한다",
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
