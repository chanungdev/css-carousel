---
/**
 * 데모와 그 코드를 같은 문자열 하나에서 만든다.
 *
 * 문서 사이트에서 제일 흔한 거짓말은 "보여주는 코드"와 "실제로 도는 것"이
 * 갈라지는 것이다. 여기서는 html·css 프롭이 렌더링과 코드 블록 양쪽의
 * 원본이라 갈라질 수가 없다 — 자동 변형을 일절 하지 않는 게 그 조건이다.
 *
 * 그래서 css는 페이지 전역으로 들어간다. 한 페이지에 css를 쓰는 데모를
 * 둘 이상 두지 않는다(선택자가 겹친다). 값 몇 개만 바꾸는 데모는 css 대신
 * 마크업의 style 속성을 쓰면 이 제약에 걸리지 않는다.
 */
import { Code } from '@astrojs/starlight/components';

interface Props {
  /** 캐러셀 마크업. 그대로 렌더되고 그대로 표시된다. */
  html: string;
  /** 이 페이지에 적용할 CSS. 그대로 적용되고 그대로 표시된다. */
  css?: string;
  /** 코드 블록 제목 */
  title?: string;
}

const { html, css, title = '코드' } = Astro.props;
---

<div class="demo" set:html={html} />

{css && <style is:inline set:html={css}></style>}

<details class="demo-code">
  <summary>{title}</summary>
  <Code code={html} lang="html" />
  {css && <Code code={css} lang="css" />}
</details>
